<?xml version="1.0"?>
<ruleset name="Pixelomatic Core">

	<description>WordPress coding standards, adjusted for PSR-4 autoloading.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<!-- Static-analysis scaffolding: defines ABSPATH so PHPStan can resolve
	     it, which is exactly what the prefix sniff exists to prevent elsewhere. -->
	<exclude-pattern>/tests/phpstan-bootstrap.php</exclude-pattern>
	<!-- Stubs mirror a third party's API for static analysis. Their names,
	     namespace and signatures are Elementor's, not ours to standardise. -->
	<exclude-pattern>/tests/stubs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="basepath" value="."/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- PSR-4 autoloading, so file names mirror class names rather than
	     WordPress's class-my-thing.php convention. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/includes/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="pixelomatic_core"/>
				<element value="PIXELOMATIC_CORE"/>
				<element value="PixelomaticCore"/>
			</property>
		</properties>
	</rule>

	<!-- Hook names use slashes: pixelomatic_core/settings/saved. This matches
	     Elementor, which the plugin extends, and makes a grep for
	     "pixelomatic_core/" find every extension point and nothing else. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="pixelomatic-core"/>
			</property>
		</properties>
	</rule>

	<!-- Security sniffs are errors, not warnings. -->
	<rule ref="WordPress.Security.EscapeOutput"><type>error</type></rule>
	<rule ref="WordPress.Security.NonceVerification"><type>error</type></rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"><type>error</type></rule>
	<rule ref="WordPress.DB.PreparedSQL"><type>error</type></rule>

</ruleset>
